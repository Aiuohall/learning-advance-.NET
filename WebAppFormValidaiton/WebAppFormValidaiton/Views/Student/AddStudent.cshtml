@model Student

@{
    ViewData["Title"] = "AddStudent";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Add New Student</h1>
<hr />
<br />

<form asp-controller="Student" method="post">
    <div asp-validation-summary="All" class="text text-danger"></div>
    <div class="mb-3">
        <label asp-for="Id" class="form-label"></label>
        <input asp-for="Id" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        @Html.LabelFor(x => x.BloodGroup, "Blood Group", new { @class = "form-label" })
        @Html.TextBoxFor(x => x.BloodGroup, "", new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
    @*<div class="mb-auto">
            @Html.EditorForModel()
        </div>*@
</form>

